# Liga o worker do MSW no browser (dev, Storybook e E2E).
NEXT_PUBLIC_API_MOCK=1
# Destino dos rewrites /api/v1 (server-side).
API_BASE_URL=http://localhost:8000
# Chave da API da empresa (server-side). O src/proxy.ts a envia como X-API-Key nas
# rotas protegidas do backend; nunca use o prefixo NEXT_PUBLIC_. Vazia = sem envio.
# Deve ser igual à API_KEY_EMPRESA do backend.
API_KEY_EMPRESA=
