# Liga o worker do MSW no browser (dev, Storybook e E2E).
NEXT_PUBLIC_API_MOCK=1
# Destino dos rewrites /api/v1 (server-side).
API_BASE_URL=http://localhost:8000
# E-mail do canal de privacidade (LGPD) exibido em /privacidade. Lido no build; vazio, a página
# aponta para o canal da equipe responsável pela instância.
NEXT_PUBLIC_EMAIL_PRIVACIDADE=
