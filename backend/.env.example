# Variáveis de ambiente do backend NovaMente
# Copie este arquivo para .env e preencha os valores

# ── Google Gemini (obrigatório) ───────────────────────────────────────────────
GOOGLE_API_KEY=

# ── Modelo LLM ────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
MODELO_LLM=gemini-3.5-flash-lite

# Tempo máximo (em segundos) de cada chamada ao LLM
LLM_TIMEOUT_SEGUNDOS=120
# Retentativa de falhas transitórias do LLM (limite de uso, indisponibilidade,
# conexão, timeout). LLM_TENTATIVAS conta a primeira chamada (mínimo 1; 1 desliga
# a retentativa). A espera começa em LLM_ESPERA_INICIAL_SEGUNDOS (mínimo 0) e
# dobra a cada tentativa, com ±20% de variação e teto de 30 s.
LLM_TENTATIVAS=3
LLM_ESPERA_INICIAL_SEGUNDOS=2

# ── OCI Object Storage (opcional — sem isso o upload fica como "falha") ───────
OCI_NAMESPACE=
OCI_BUCKET=novamente-conteudos-educativos
OCI_REGIAO=sa-saopaulo-1
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Caminho relativo à pasta backend/ (já ignorada pelo .gitignore).
# Fora do Docker, /data/chroma normalmente não existe nem é gravável.
CHROMA_DIR=./data/chroma

# ── Servidor ──────────────────────────────────────────────────────────────────
DEBUG=false

# Arquivo SQLite dos jobs e do histórico. Em produção, aponte para um volume persistente.
DB_PATH=./data/novamente.sqlite3
