# Variáveis de ambiente do backend NovaMente
# Copie este arquivo para .env e preencha os valores

# ── Google Gemini (obrigatório) ───────────────────────────────────────────────
GOOGLE_API_KEY=

# ── Modelo LLM ────────────────────────────────────────────────────────────────
MODELO_LLM=gemini-3.5-flash-lite

# Tempo máximo (em segundos) de cada chamada ao LLM
LLM_TIMEOUT_SEGUNDOS=120

# ── OCI Object Storage (opcional — sem isso o upload fica como "falha") ───────
OCI_NAMESPACE=
OCI_BUCKET=novamente-conteudos-educativos
OCI_REGIAO=sa-saopaulo-1
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# ── Banco de dados ───────────────────────────────────────────────────────────
# SQLite local do catálogo de materiais, alunos e vínculos.
DATABASE_URL=sqlite:///./data/novamente.db

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Caminho relativo à pasta backend/ (já ignorada pelo .gitignore).
# Fora do Docker, /data/chroma normalmente não existe nem é gravável.
CHROMA_DIR=./data/chroma

# ── Servidor ──────────────────────────────────────────────────────────────────
DEBUG=false

# Arquivo SQLite dos jobs e do histórico. Por padrão, o mesmo do catálogo.
# Em produção, aponte para um volume persistente.
DB_PATH=./data/novamente.db
