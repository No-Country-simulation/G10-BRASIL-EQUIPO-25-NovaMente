# Variáveis de ambiente do backend NovaMente
# Copie este arquivo para .env e preencha os valores

# ── Google Gemini (obrigatório) ───────────────────────────────────────────────
GOOGLE_API_KEY=

# ── Modelo LLM ────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
MODELO_LLM=gemini-3.5-flash-lite

# Tempo máximo (em segundos) de cada chamada ao LLM
LLM_TIMEOUT_SEGUNDOS=120
# Retentativa de falhas transitórias do LLM (limite de uso, indisponibilidade,
# conexão, timeout). LLM_TENTATIVAS conta a primeira chamada (mínimo 1; 1 desliga
# a retentativa). A espera começa em LLM_ESPERA_INICIAL_SEGUNDOS (mínimo 0) e
# dobra a cada tentativa, com ±20% de variação e teto de 30 s.
LLM_TENTATIVAS=3
LLM_ESPERA_INICIAL_SEGUNDOS=2

# ── NVIDIA NIM (opcional; usado com LLM_PROVIDER=nvidia) ──────────────────────
# A chave só é exigida na geração; deixe vazia se não usar a NVIDIA.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# O catálogo gratuito muda com frequência: confira os ids com scripts/comparar_modelos.py --listar.
NVIDIA_NIM_MODELO=nvidia/nemotron-3.5-lightning-30b-a3b
# Limite de tokens da resposta, raciocínio incluído; precisa ser maior que o orçamento de raciocínio.
NVIDIA_NIM_MAX_TOKENS=8192
# Vazio: vale a temperatura padrão do modelo (como no Gemini).
NVIDIA_NIM_TEMPERATURA=
# Raciocínio: desligado (padrão; vazio vale o mesmo), ligado ou padrao (não envia, vale o do modelo).
# Ligado, ele consome NVIDIA_NIM_MAX_TOKENS e o JSON sai cortado. Outro valor impede a subida.
NVIDIA_NIM_RACIOCINIO=desligado
# Tokens de raciocínio (reasoning_budget); vazio não envia. Ignorado com o raciocínio desligado.
NVIDIA_NIM_ORCAMENTO_RACIOCINIO=

# ── Segurança (CORS, limites de uso e logs) ───────────────────────────────────
# Origens permitidas no CORS, separadas por vírgula, no formato esquema://host[:porta]
# (sem barra final). "*" impede a subida: o CORS usa credenciais.
CORS_ORIGINS=http://localhost:3000
# Gerações (POST /adaptacoes e /adaptacoes/upload) por minuto, por IP (mínimo 1).
GERACAO_LIMITE_POR_MINUTO=6
# Jobs de geração em andamento ao mesmo tempo (mínimo 1). Acima disso: 503.
GERACAO_MAX_JOBS_SIMULTANEOS=4
# Usa o X-Forwarded-For como IP do cliente nos limites por IP (login e gerações).
# Só ligue atrás de um proxy confiável (o Caddy) que sobrescreva o cabeçalho do
# cliente, com a porta 8000 do backend fechada; senão qualquer cliente forja o IP
# e burla os limites. Vale a última entrada do cabeçalho, a do proxy.
CONFIAR_X_FORWARDED_FOR=false

# ── OCI Object Storage (opcional — sem isso o upload fica como "falha") ───────
OCI_NAMESPACE=
OCI_BUCKET=novamente-conteudos-educativos
OCI_REGIAO=sa-saopaulo-1
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# ── Banco de dados ───────────────────────────────────────────────────────────
# SQLite local do catálogo de materiais, alunos e vínculos.
DATABASE_URL=sqlite:///./data/novamente.db

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Caminho relativo à pasta backend/ (já ignorada pelo .gitignore).
# Fora do Docker, /data/chroma normalmente não existe nem é gravável.
CHROMA_DIR=./data/chroma

# ── Servidor ──────────────────────────────────────────────────────────────────
DEBUG=false

# Chave das rotas da empresa (alunos, materiais e escrita em adaptações/jobs).
# Quando definida, essas rotas exigem o cabeçalho X-API-Key com este valor.
# Vazia, elas ficam abertas (dev local) e o backend avisa no log.
# Com AUTH_HABILITADA=true, todas as rotas da empresa aceitam a sessão de empresa
# ou este X-API-Key (para scripts); vazia, só a sessão.
# Gere um valor longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(32))")
# e nunca versione o .env com ele preenchido.
API_KEY_EMPRESA=

# Arquivo SQLite dos jobs e do histórico. Por padrão, o mesmo do catálogo.
# Em produção, aponte para um volume persistente.
DB_PATH=./data/novamente.db

# ── Chat sobre o material (provedor próprio, independente de LLM_PROVIDER) ──
# Vazio em qualquer CHAT_* vale o padrão indicado. A chave é a do provedor
# (na nvidia, NVIDIA_NIM_API_KEY) e só é exigida quando o chat é usado.
# Provedor registrado: nvidia (padrão) ou gemini
CHAT_LLM_PROVIDER=
# Vazio: google/gemma-4-31b-it na nvidia; MODELO_LLM no gemini
CHAT_LLM_MODELO=
# ligado ou desligado (padrão: desligado; ligado deixa as respostas lentas)
CHAT_LLM_RACIOCINIO=
# Limite de tokens da resposta (padrão: 1024, mínimo 64)
CHAT_LLM_MAX_TOKENS=
# Temperatura entre 0 e 2 (padrão: 0.2)
CHAT_LLM_TEMPERATURA=
# Prazo total de uma pergunta, retentativa incluída (padrão: 45, mínimo 5)
CHAT_LLM_TIMEOUT_SEGUNDOS=
# Ids aceitos, separados por vírgula (padrão na nvidia: google/gemma-4-31b-it,nvidia/nemotron-3.5-bolt-e4b,nvidia/nemotron-3.5-lightning-30b-a3b; o modelo do chat sempre entra primeiro)
CHAT_MODELOS_PERMITIDOS=
# Limites do serviço do chat
CHAT_MAX_PERGUNTA_CARACTERES=
CHAT_MAX_MENSAGENS_HISTORICO=
CHAT_MAX_CONTEXTO_CARACTERES=
# Perguntas por minuto, por aluno (padrão: 12)
CHAT_LIMITE_POR_MINUTO=

# ── Geração multiagente (grafo com revisões; desligada por padrão) ──────────
# Vazio vale o padrão indicado.
# true liga o grafo roteador -> pesquisador -> redator -> crítico (padrão: false)
GERACAO_MULTIAGENTE=
# Revisões depois da primeira escrita, de 0 a 2 (padrão: 2)
GRAFO_MAX_REVISOES=
# Ancoragem que aprova o rascunho, de 0 a 1 (padrão: 0.75, provisório)
GRAFO_LIMIAR_ANCORAGEM=
# Jobs no grafo ao mesmo tempo; sem vaga, o job vai pela passada única (padrão: 2)
GRAFO_MAX_SIMULTANEOS=

# ── Login (empresa e aluno: senha + código de 6 dígitos por e-mail) ─────────
# Vazio vale o padrão indicado. Desligado, as rotas ficam abertas como antes.
# true liga o login e as guardas em todas as rotas (padrão: false)
AUTH_HABILITADA=
# true libera POST /api/v1/auth/demo (sessões de demonstração de 2 h, sem código; padrão: false)
DEMO_HABILITADO=
# Assina o cookie de sessão e os códigos; obrigatório com o login ligado, mínimo 32 caracteres
SESSAO_SEGREDO=
# true envia o cookie só por HTTPS; use true em produção (padrão: false)
SESSAO_COOKIE_SEGURO=
# Conta da empresa: e-mail e hash da senha (gere com: python scripts/gerar_hash_senha.py).
# O hash tem "$": coloque-o entre aspas simples (EMPRESA_SENHA_HASH='scrypt$...') para o
# docker compose não tentar expandir variáveis.
EMPRESA_EMAIL=
EMPRESA_SENHA_HASH=
# console (só desenvolvimento: o código aparece no log) ou smtp (padrão: console)
EMAIL_MODO=
# SMTP com STARTTLS; obrigatórios com EMAIL_MODO=smtp, exceto a porta (padrão: 587)
SMTP_HOST=
SMTP_PORTA=
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# ── Backup do SQLite ──────────────────────────────────────────────────────────
# Gerado por `python -m app.scripts.backup`. BACKUP_DIR é relativo à pasta backend/
# (já ignorada pelo .gitignore); em produção, aponte para um volume diferente do
# banco. BACKUP_RETENCAO é a quantidade de backups mantidos (mínimo 1).
BACKUP_DIR=./data/backups
BACKUP_RETENCAO=7
